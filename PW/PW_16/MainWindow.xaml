<Window x:Class="PW_16.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PW_16"
        mc:Ignorable="d"
        Title="Заметки" Height="350" Width="525" MinWidth="525" MinHeight="350" MaxWidth="525" MaxHeight="350">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ListBox x:Name="NotesListBox" DisplayMemberPath="Title" SelectionChanged="NotesListBox_SelectionChanged" />

        <StackPanel Grid.Column="1" Margin="10">
            <TextBox x:Name="TitleTextBox" 
                     Height="30" Margin="0,0,0,10" 
                     IsEnabled="False" 
                     Background="WhiteSmoke"
                     GotFocus="TitleTextBox_GotFocus" 
                     LostFocus="TitleTextBox_LostFocus"
                     Tag="Заголовок" />
            <TextBox x:Name="ContentTextBox" 
                     AcceptsReturn="True" Height="200"
                     IsEnabled="False" 
                     Background="WhiteSmoke"
                     GotFocus="ContentTextBox_GotFocus" 
                     LostFocus="ContentTextBox_LostFocus"
                     Tag="Содержимое" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="AddButton"  Content="Добавить" Click="AddButton_Click" Margin="0,0,5,0"/>
                <Button x:Name="EditButton"  Content="Редактировать" Click="EditButton_Click" Margin="0,0,5,0"/>
                <Button Content="Удалить" Click="DeleteButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
