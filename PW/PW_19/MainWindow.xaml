<Window x:Class="PW_19.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PW_19"
        mc:Ignorable="d"
         Title="Судоку" Height="500" Width="500">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Кнопки управления -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button Content="Начать игру" Width="100" Margin="5" Click="StartGame"/>
            <Button Content="Выход" Width="100" Margin="5" Click="ExitGame"/>
        </StackPanel>

        <!-- Игровая сетка -->
        <Grid Grid.Row="1" Name="SudokuGrid" Margin="10">
            <!-- Сетка создается программно -->
        </Grid>

        <!-- Кнопка проверки -->
        <Button Grid.Row="2" Content="Проверить" HorizontalAlignment="Center" Margin="10" Click="CheckSudoku"/>
    </Grid>
</Window>
