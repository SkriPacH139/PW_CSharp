<Window x:Class="PW_16_2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PW_16_2"
        mc:Ignorable="d"
        Title="Шифр цезаря" Height="350" Width="400" MinWidth="400" MinHeight="350" MaxHeight="350" MaxWidth="400">
    <Grid Margin="10">
        <Label Content="Введите текст:" VerticalAlignment="Top"/>
        <TextBox x:Name="InputTextBox" Height="50" VerticalAlignment="Top" Margin="0,20,0,0"/>

        <Label Content="Сдвиг (0-25):" VerticalAlignment="Top" Margin="0,80,0,0"/>
        <TextBox x:Name="ShiftTextBox" Height="30" VerticalAlignment="Top" Margin="0,100,0,0"/>

        <Button Content="Зашифровать" VerticalAlignment="Top" Margin="0,140,0,0" Click="EncryptButton_Click"/>

        <Label Content="Зашифрованный текст:" VerticalAlignment="Top" Margin="0,180,0,0"/>
        <TextBox x:Name="OutputTextBox" Height="50" VerticalAlignment="Top" Margin="0,200,0,0" IsReadOnly="True"/>
    </Grid>
</Window>
