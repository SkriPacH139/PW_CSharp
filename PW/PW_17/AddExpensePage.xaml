<Page x:Class="PW_17.AddExpensePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PW_17"
      mc:Ignorable="d" 
      d:DesignHeight="350" d:DesignWidth="400"
      Title="AddExpensePage" MinWidth="400" MaxWidth="400" MinHeight="350" MaxHeight="350" >

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
            <TextBlock Text="Добавить расход" TextAlignment="Center" />

            <!-- TextBox с Placeholder -->
            <TextBox Name="ExpenseTextBox" Text="Сумма расхода" Width="200"
                     GotFocus="TextBox_GotFocus" LostFocus="TextBox_LostFocus" />

            <!-- Дата -->
            <DatePicker Margin="0,10" Width="200" />

            <!-- Список категорий -->
            <ComboBox Margin="0,10" Width="200">
                <ComboBoxItem Content="Продукты" />
                <ComboBoxItem Content="Транспорт" />
                <ComboBoxItem Content="Развлечения" />
                <ComboBoxItem Content="Другое" />
            </ComboBox>

            <!-- Кнопка добавления категории -->
            <Button Content="Добавить новую категорию" Width="200" Visibility="Hidden" />

            <!-- Кнопка сохранения -->
            <Button Content="Сохранить"  Width="200"
                    Click="SaveExpense_Click" />
        </StackPanel>
    </Grid>
</Page>
